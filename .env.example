# OpenRouter API key (read by langchain-openrouter)
OPENROUTER_API_KEY=

# Resolution APIs (Step 2)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Last.fm. The API key alone is read-only (enough for resolution lookups).
# Scrobbling additionally needs the SHARED SECRET: every write call is signed
# md5(sorted params + secret). Both are shown on the "Account Created" page at
# https://www.last.fm/api/account/create — the secret is often NOT shown again
# afterwards, so if last.fm/api/accounts only lists your key, create a fresh
# API account and copy both before leaving that page.
LASTFM_API_KEY=
LASTFM_SECRET=

# Neon Postgres cache table (Step 3-lite) - connection string from neon.tech
DATABASE_URL=

# Playlist export (Step 4)
# Spotify: reuse SPOTIFY_CLIENT_ID/SECRET above; register this redirect URI in the
# Spotify app dashboard. Default matches SOUNDSEEK_EXPORT_REDIRECT_PORT (8888).
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# YouTube: a Google Cloud OAuth *desktop* client with the YouTube Data API enabled,
# and http://127.0.0.1:8888/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the web app finds the read API. In production this is the deployed API's
# URL, set in the web host's env — Next bakes it into the /api/* rewrite.
API_URL=http://127.0.0.1:8010

# The web app's own origin. The API derives two things from it: where Last.fm
# sends the user back, and whether the session cookie gets the Secure flag.
# MUST be the real https origin in production.
# SOUNDSEEK_WEB_URL=https://danceseek.example.com

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Where fetch() gets its HTML:
#   local   drive a real browser here — the default, and what ingestion uses
#   stored  read a page captured earlier into Postgres (re-normalize without
#           re-scraping; also what a server would use if ingestion ever moves back)
#   managed third-party browser API (not implemented yet)
# SOUNDSEEK_FETCH_BACKEND=local

# Optional overrides
# SOUNDSEEK_LLM_MODEL=google/gemma-4-31b-it:free
# SOUNDSEEK_HEADLESS=true
# SOUNDSEEK_FETCH_DELAY_SECONDS=2.0
# SOUNDSEEK_RESOLVE_MIN_CONFIDENCE=0.75
