    "/auth/lastfm/start": {
      "get": {
        "summary": "Lastfm Start",
        "description": "Send the user to Last.fm to approve us, remembering the request token.\n\nThe token is kept in a short-lived signed cookie so the approval can be\ncompleted on the user's return even if Last.fm never calls us back.",
        "operationId": "lastfm_start_auth_lastfm_start_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/auth/lastfm/callback": {
      "get": {
        "summary": "Lastfm Callback",
        "description": "Trade the approved token for a session and sign the user in.\n\nUses the token Last.fm hands back, falling back to the one we stashed at\nthe start of the flow — a user who returns by any route still lands signed in.",
        "operationId": "lastfm_callback_auth_lastfm_callback_get",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Token"
            }
          },
          {
            "name": "ds_pending",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ds Pending"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/lastfm/complete": {
      "post": {
        "summary": "Lastfm Complete",
        "description": "Finish a connection whose callback never arrived.\n\nLast.fm only redirects back when the API account has a Callback URL\nregistered; without one it shows its own success page and leaves the user\nto navigate back. The approved token is still redeemable, so this closes\nthe loop from the app side.",
        "operationId": "lastfm_complete_auth_lastfm_complete_post",
        "parameters": [
          {
            "name": "ds_pending",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ds Pending"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout",
        "description": "Forget the browser. The stored Last.fm session key is left intact so\nreconnecting doesn't need another round trip to Last.fm.",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
