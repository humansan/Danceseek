    "/setlists/{setlist_id}/cues": {
      "get": {
        "summary": "Setlist Cues",
        "description": "Cue windows: which track is playing when, and under what name.\n\nThe client reports the player's duration; everything else is derived here so\nthe highlight and the scrobbler can never disagree about what's playing.",
        "operationId": "setlist_cues_setlists__setlist_id__cues_get",
        "parameters": [
          {
            "name": "setlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Setlist Id"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Recording length in seconds, when known",
              "title": "Duration"
            },
            "description": "Recording length in seconds, when known"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WindowSet"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/setlists/{setlist_id}/export": {
      "post": {
        "summary": "Export Preview",
        "description": "Dry-run preview: the ordered add-list + skip report for a target platform.\n\nNetwork-free (uses exporter.collect.build_plan). Actual playlist creation\nneeds a connected account and lands with the export phase.",
        "operationId": "export_preview_setlists__setlist_id__export_post",
        "parameters": [
          {
            "name": "setlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Setlist Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportPreviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
